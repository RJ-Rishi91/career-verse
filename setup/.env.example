# CareerVerse environment (copy to .env.local). Never commit real secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (docker compose provides this locally)
DATABASE_URL=postgresql://careerverse:careerverse@localhost:5432/careerverse

# Sessions and encryption
SESSION_SECRET=change-me-64-random-bytes
ENCRYPTION_KEY=change-me-32-byte-base64        # encrypts TOTP secrets at rest
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
ADMIN_SESSION_TTL_HOURS=12

# Master admin bootstrap (used once by `pnpm admin:bootstrap`; prints a one-time setup link)
MASTER_ADMIN_EMAIL=owner@example.com

# Email (dev uses Mailpit from docker compose)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="CareerVerse <no-reply@careerverse.local>"

# Security
RATE_LIMIT_LOGIN_PER_15MIN=10
LOCKOUT_AFTER_FAILURES=8
LOCKOUT_MINUTES=15

# Dev conveniences (never enable in production)
DEV_AUTOPUBLISH_IN_REVIEW=true
DEV_SKIP_EMAIL_VERIFICATION=false
